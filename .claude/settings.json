{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh tools/turnstile/turnstile-run .claude/hooks/push-goes-where-you-are.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh tools/turnstile/turnstile-run .claude/hooks/no-heredoc-source.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/send-goes-nowhere.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
